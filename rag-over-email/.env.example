# Optional API keys for RAG over Email.
# The app works WITHOUT any key (it falls back to extractive answers).
# For full LLM-generated answers, set ONE of these as an environment variable
# (or copy this file to ".env" and load it with python-dotenv).

# OpenAI
OPENAI_API_KEY=

# ...or free GitHub Models (uses your GitHub token instead)
# GITHUB_TOKEN=

# Optional: which model to use
RAG_MODEL=gpt-4o-mini
