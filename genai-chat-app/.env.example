# Copy this file to ".env" and fill in ONE provider's settings.
# (.env is git-ignored, so your keys never get committed.)

# Where the model runs:  github | azure | openai
PROVIDER=github

# --- GitHub Models (FREE, easiest) ---
# Create a token (no scopes needed): https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# --- Azure OpenAI (Microsoft Applied Skills) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional chat behavior (all providers)
# SYSTEM_PROMPT=You are a helpful, friendly assistant.
# TEMPERATURE=0.7
# MAX_TOKENS=800
